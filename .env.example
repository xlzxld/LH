# ============================================================
# 量化教程项目 —— 全部配置模板
# 使用方法：复制本文件为 .env，然后按需填写（.env 含密钥，切勿分享/上传）
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# 注意：同名环境变量会覆盖 .env（比如之前 export 过 BINANCE_TESTNET=false 的
# 旧终端窗口）——改完 .env 不生效时，先开个新终端。
# ============================================================

# ---------- 微信推送（第 10 章；不配置则 NOTIFY_CHANNEL=off 只打印） ----------
# 可选: serverchan | pushplus | wecom | off
NOTIFY_CHANNEL=off
# Server酱 SendKey: https://sct.ftqq.com 微信扫码登录后复制
SERVERCHAN_SENDKEY=
# PushPlus token: https://www.pushplus.plus 微信扫码登录后复制
PUSHPLUS_TOKEN=
# 企业微信群机器人 Webhook 地址（免费、无条数限制、最推荐长期使用）
WECOM_WEBHOOK=

# ---------- 币安（第 9 章；只跑回测/监测可完全不填） ----------
# 测试网(假钱)申请: https://testnet.binance.vision 用 GitHub 账号登录即可
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = 测试网模拟盘（新手必保持 true），false = 真实账户
# 注意：此开关只对 binance 生效；实盘机器人的下单开关以交易所实例真实沙箱态为准
BINANCE_TESTNET=true
# ccxt 交易所 id: binance / okx ...
EXCHANGE_ID=binance
# 公共行情域名（大陆可直连的币安官方数据源，全球可用；默认即可）
BINANCE_DATA_HOST=https://data-api.binance.vision/api/v3
# 每笔买入花费的计价货币金额（USDT）
QUOTE_PER_TRADE=50

# ---------- OKX（可选；换 EXCHANGE_ID=okx 时填写三件套） ----------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ---------- A股监测（第 10 章） ----------
# 监测列表，逗号分隔；etf: 沪深 ETF 6 位代码，stock: 股票代码
WATCHLIST=etf:510300,etf:512100,etf:510500
MA_FAST=20
MA_SLOW=60
# 创 N 日新高提醒
BREAKOUT_DAYS=60
# 距 N 日高点回撤超过该百分比时提醒
DRAWDOWN_PCT=10
DRAWDOWN_DAYS=60
# 同类事件提醒（新高/回撤）的冷却天数：防止持续回撤期天天轰炸把免费配额烧光
ALERT_COOLDOWN_DAYS=3
# 拉取日线数据的起始日期（越久越慢，1 年足够算均线）
LOOKBACK_START=20240101

# ---------- 回测默认参数（第 4 章；可用命令行 --cash/--commission 等覆盖） ----------
# A股 ETF 佣金约 0.0001~0.0003（无印花税，另有最低佣金可用 --min-fee 5 建模）；
# 币安现货 0.001
COMMISSION_RATE=0.00025
SLIPPAGE_RATE=0.0005
INITIAL_CASH=100000
