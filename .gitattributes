# 换行规范：仓库内统一存 LF，按文件类型决定检出的换行符
# （解决 Windows 上 LF/CRLF 混用导致的 git 警告与假 diff）
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.sh   text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件不做任何转换
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.csv  -text
